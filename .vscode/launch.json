{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Cortex-Debug / OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/FOCtest.elf",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "device": "STM32F103C8",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "runToEntryPoint": "main",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug (C/C++ / OpenOCD)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/FOCtest.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/arm-none-eabi-gdb",
            "preLaunchTask": "start-openocd",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set remote target to port 3333",
                    "text": "target remote :3333",
                    "ignoreFailures": false
                },
                {
                    "description": "Reset and halt the target",
                    "text": "monitor reset halt",
                    "ignoreFailures": false
                },
                {
                    "description": "Flash the firmware",
                    "text": "load",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
